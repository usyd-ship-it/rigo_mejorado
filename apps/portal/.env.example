# URL base de apps/api — distinta en producción, nunca hardcodear localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Cloudflare Turnstile — site key PÚBLICA (no es secreta, se usa tal
# cual en el HTML). Mientras apps/api use la secret key de prueba
# "siempre aprueba" de Cloudflare (TURNSTILE_SECRET_KEY), esta es la
# site key de prueba oficial que combina con ese modo. El día que
# exista la site key real de producción, este es el único valor que
# hay que cambiar.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
