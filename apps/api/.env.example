DATABASE_URL=postgresql://user:password@host:5432/postgres

# Cloudflare Turnstile — verificación server-side del CAPTCHA público
TURNSTILE_SECRET_KEY=

# Cloudflare R2 — evidencias fotográficas (API compatible S3)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase Auth — verificación de sesión de apps/mando.
# SUPABASE_SERVICE_ROLE_KEY nunca debe llegar al frontend (apps/mando).
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
