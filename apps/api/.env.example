DATABASE_URL=postgresql://user:password@host:5432/postgres

# Cloudflare Turnstile — verificación server-side del CAPTCHA público.
# Este es el valor de prueba oficial de Cloudflare, modo "siempre
# aprueba" — combina con la site key de prueba que ya usa
# apps/portal/.env.example (1x00000000000000000000AA). OJO: la secret
# key y la site key de prueba NO son el mismo string — Cloudflare las
# documenta como un par de dos valores distintos, este es el de secret.
# Pendiente antes de producción real: reemplazar por la key real del
# proyecto de Cloudflare Turnstile del municipio — no resuelto aquí.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare R2 — evidencias fotográficas (API compatible S3)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supabase Auth — verificación de sesión de apps/mando.
# SUPABASE_SERVICE_ROLE_KEY nunca debe llegar al frontend (apps/mando).
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS de /mando — dominio real de apps/mando en producción, nunca localhost.
MANDO_ORIGIN=http://localhost:3001
